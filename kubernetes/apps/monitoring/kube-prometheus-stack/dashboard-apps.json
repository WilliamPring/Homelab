    {
      "id": 12,
      "type": "timeseries",
      "title": "CPU throttling",
      "description": "Share of time slices where the app hit limits.cpu and was paused. Sustained > 25% = it's slow because of its CPU limit (this repo mostly sets none — then this stays at 0).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 25,
        "w": 12,
        "h": 9
