      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum by (namespace, workload) (\n  rate(container_cpu_cfs_throttled_periods_total{container!=\"\", namespace=~\"$namespace\"}[5m])\n  * on (namespace, pod) group_left (workload) namespace_workload_pod:kube_pod_owner:relabel{namespace=~\"$namespace\", workload=~\"$app\"}\n)) / (sum by (namespace, workload) (\n  rate(container_cpu_cfs_periods_total{container!=\"\", namespace=~\"$namespace\"}[5m])\n  * on (namespace, pod) group_left (workload) namespace_workload_pod:kube_pod_owner:relabel{namespace=~\"$namespace\", workload=~\"$app\"}\n))",
          "legendFormat": "{{namespace}}/{{workload}}",
          "range": true,
          "instant": false
