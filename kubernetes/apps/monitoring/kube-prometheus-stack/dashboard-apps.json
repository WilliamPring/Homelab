{
  "title": "Homelab apps",
  "uid": "homelab-apps",
  "description": "CPU, RAM, restarts, network and disk for every app at a glance, plus the OpenBao secret sync. Per-pod detail: the 'Kubernetes / Compute Resources / Workload' dashboard. Logs: 'App logs'.",
  "tags": [
    "homelab"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "links": [
    {
      "title": "App logs",
      "type": "link",
      "url": "/d/homelab-app-logs",
      "icon": "doc"
    },
    {
      "title": "Per-pod detail (Workload)",
      "type": "dashboards",
      "tags": [
        "kubernetes-mixin"
      ],
      "asDropdown": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(kube_pod_info, namespace)",
          "refId": "ns"
        },
        "definition": "label_values(kube_pod_info, namespace)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": [
            "apps",
            "media",
            "monitoring"
          ],
          "value": [
            "apps",
            "media",
            "monitoring"
          ]
        },
        "sort": 1
      },
      {
        "name": "app",
        "label": "App",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(namespace_workload_pod:kube_pod_owner:relabel{namespace=~\"$namespace\"}, workload)",
          "refId": "app"
        },
        "definition": "label_values(namespace_workload_pod:kube_pod_owner:relabel{namespace=~\"$namespace\"}, workload)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Cluster CPU used",
      "description": "Share of all cores on both nodes in use right now.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m]))",
          "legendFormat": "",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.7
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Cluster RAM used",
      "description": "Share of both nodes' RAM in use (MemAvailable-based, so page cache doesn't count).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - sum(node_memory_MemAvailable_bytes) / sum(node_memory_MemTotal_bytes)",
          "legendFormat": "",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Pods not ready",
      "description": "Pods in the selected namespaces that are Running but not Ready, or stuck Pending.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(kube_pod_status_ready{condition=\"false\", namespace=~\"$namespace\"} * on (namespace, pod) group_left () (kube_pod_status_phase{phase=\"Running\"} == 1)) or vector(0)) + (sum(kube_pod_status_phase{phase=\"Pending\", namespace=~\"$namespace\"}) or vector(0))",
          "legendFormat": "",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Restarts (24h)",
      "description": "Container restarts in the last 24 h, all selected apps. A few after a Sync is normal; a steady climb is not.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=~\"$namespace\"}[24h])) or vector(0)",
          "legendFormat": "",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "OOM-killed containers",
      "description": "Containers whose LAST exit was an OOMKill (out of memory: raise limits.memory, or find the leak).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(kube_pod_container_status_last_terminated_reason{reason=\"OOMKilled\", namespace=~\"$namespace\"}) or vector(0)",
          "legendFormat": "",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value"
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Secrets not syncing",
      "description": "ExternalSecrets (OpenBao → Kubernetes Secret) that are not Ready. See the Secrets row below.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(externalsecret_status_condition{condition=\"Ready\", status=\"False\"}) or vector(0)",
          "legendFormat": "",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value"
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Every app, right now",
      "description": "One row per app (Deployment / StatefulSet / DaemonSet). Sorted by RAM. 'RAM % of limit' near 100% = about to be OOM-killed. A blank limit means at least one container has no limits.memory.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 11
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (namespace, workload) (\n  node_namespace_pod_container:container_cpu_usage_seconds_total:sum_rate5m{namespace=~\"$namespace\"}\n  * on (namespace, pod) group_left (workload) namespace_workload_pod:kube_pod_owner:relabel{namespace=~\"$namespace\", workload=~\"$app\"}\n)",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (namespace, workload) (\n  cluster:namespace:pod_cpu:active:kube_pod_container_resource_requests{namespace=~\"$namespace\"}\n  * on (namespace, pod) group_left (workload) namespace_workload_pod:kube_pod_owner:relabel{namespace=~\"$namespace\", workload=~\"$app\"}\n)",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (namespace, workload) (\n  node_namespace_pod_container:container_memory_working_set_bytes{namespace=~\"$namespace\"}\n  * on (namespace, pod) group_left (workload) namespace_workload_pod:kube_pod_owner:relabel{namespace=~\"$namespace\", workload=~\"$app\"}\n)",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (namespace, workload) (\n  cluster:namespace:pod_memory:active:kube_pod_container_resource_limits{namespace=~\"$namespace\"}\n  * on (namespace, pod) group_left (workload) namespace_workload_pod:kube_pod_owner:relabel{namespace=~\"$namespace\", workload=~\"$app\"}\n)",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum by (namespace, workload) (\n  node_namespace_pod_container:container_memory_working_set_bytes{namespace=~\"$namespace\"}\n  * on (namespace, pod) group_left (workload) namespace_workload_pod:kube_pod_owner:relabel{namespace=~\"$namespace\", workload=~\"$app\"}\n)) / (sum by (namespace, workload) (\n  cluster:namespace:pod_memory:active:kube_pod_container_resource_limits{namespace=~\"$namespace\"}\n  * on (namespace, pod) group_left (workload) namespace_workload_pod:kube_pod_owner:relabel{namespace=~\"$namespace\", workload=~\"$app\"}\n))",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "refId": "F",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (namespace, workload) (\n  increase(kube_pod_container_status_restarts_total{namespace=~\"$namespace\"}[24h])\n  * on (namespace, pod) group_left (workload) namespace_workload_pod:kube_pod_owner:relabel{namespace=~\"$namespace\", workload=~\"$app\"}\n)",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "CPU (cores)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "decimals",
                "value": 3
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "CPU requested"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "decimals",
                "value": 3
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "RAM"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "RAM limit"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "RAM % of limit"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 0.8
                    },
                    {
                      "color": "red",
                      "value": 0.95
                    }
                  ]
                }
              },
              {
                "id": "max",
                "value": 1
              },
              {
                "id": "min",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Restarts 24h"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 1
                    },
                    {
                      "color": "red",
                      "value": 5
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "namespace": 0,
              "workload": 1,
              "Value #A": 2,
              "Value #B": 3,
              "Value #C": 4,
              "Value #D": 5,
              "Value #E": 6,
              "Value #F": 7
            },
            "renameByName": {
              "namespace": "Namespace",
              "workload": "App",
              "Value #A": "CPU (cores)",
              "Value #B": "CPU requested",
              "Value #C": "RAM",
              "Value #D": "RAM limit",
              "Value #E": "RAM % of limit",
              "Value #F": "Restarts 24h"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "RAM",
                "desc": true
              }
            ]
          }
        }
      ]
    },
    {
      "id": 8,
      "type": "row",
      "title": "Over time",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "CPU per app",
      "description": "Cores used (1 = one full core). 5-minute average.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (namespace, workload) (\n  node_namespace_pod_container:container_cpu_usage_seconds_total:sum_rate5m{namespace=~\"$namespace\"}\n  * on (namespace, pod) group_left (workload) namespace_workload_pod:kube_pod_owner:relabel{namespace=~\"$namespace\", workload=~\"$app\"}\n)",
          "legendFormat": "{{namespace}}/{{workload}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "sortBy": "Last *",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "RAM per app",
      "description": "Working set — what the kernel counts against limits.memory (the OOM number).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (namespace, workload) (\n  node_namespace_pod_container:container_memory_working_set_bytes{namespace=~\"$namespace\"}\n  * on (namespace, pod) group_left (workload) namespace_workload_pod:kube_pod_owner:relabel{namespace=~\"$namespace\", workload=~\"$app\"}\n)",
          "legendFormat": "{{namespace}}/{{workload}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "sortBy": "Last *",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "RAM % of limit, per container",
      "description": "Each container's working set ÷ its limits.memory. Crossing 100% = OOMKilled. Containers without a limit don't appear.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum by (namespace, workload, container) (\n  node_namespace_pod_container:container_memory_working_set_bytes{namespace=~\"$namespace\"}\n  * on (namespace, pod) group_left (workload) namespace_workload_pod:kube_pod_owner:relabel{namespace=~\"$namespace\", workload=~\"$app\"}\n)) / (sum by (namespace, workload, container) (\n  cluster:namespace:pod_memory:active:kube_pod_container_resource_limits{namespace=~\"$namespace\"}\n  * on (namespace, pod) group_left (workload) namespace_workload_pod:kube_pod_owner:relabel{namespace=~\"$namespace\", workload=~\"$app\"}\n))",
          "legendFormat": "{{workload}} · {{container}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "line+area"
            }
          },
          "max": 1.1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
