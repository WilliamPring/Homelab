      "panels": []
    },
    {
      "id": 21,
      "type": "table",
      "title": "ExternalSecrets",
      "description": "Each Kubernetes Secret that comes from OpenBao. ❌ = can't refresh (OpenBao down/sealed, login revoked, key missing) — the old Secret is kept, so running pods are fine. `kubectl -n <ns> describe externalsecret <name>` says why.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 59,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (namespace, name) (externalsecret_status_condition{condition=\"Ready\", status=\"True\"})",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "✅ synced",
                  "color": "green"
                },
                "0": {
                  "text": "❌ failing",
                  "color": "red"
                }
              }
            }
          ],
          "custom": {
            "cellOptions": {
              "type": "color-background"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "namespace": "Namespace",
              "name": "Secret",
              "Value": "Synced from OpenBao"
            }
          }
        }
      ]
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "OpenBao reads by External Secrets",
      "description": "Calls ESO made to OpenBao, split by result. Errors here = the ❌ rows' cause.",
