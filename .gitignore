# Never commit secrets
*.env
*.secret
acme.json
kubeconfig
# ⚠️ Comments must sit on their OWN line: git has no inline comments, so `k3s.yaml  # note`
#    would be one pattern (text and all) that never matches the file.
# the k3s admin kubeconfig — cluster-admin in a single file
k3s.yaml
*.agekey
# sops/age private key file (`age-keygen -o keys.txt`)
keys.txt
*.pem
*.key
*.crt

# SOPS leaves these behind if an edit session is interrupted — they hold DECRYPTED content
.decrypted~*
*.decrypted.yaml

# `make diag` writes a cluster dump here and tells you to commit it. Review it first: it is a
# paste of live cluster state, and this repo is PUBLIC. Un-ignore deliberately, per file.
debug/*.txt

# Local overrides
*.local.yaml
*.local.sh

# Ansible
ansible/ansible.log
*.retry

# kustomize `helmCharts:` downloads charts next to the kustomization when rendering locally
kubernetes/**/charts/
