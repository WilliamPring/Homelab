# Rendered by the helm_app role — a k3s HelmChart CRD.
# k3s's built-in Helm controller watches these and installs the chart for us,
# so we never run the `helm` command ourselves.
apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: {{ helm_app_name }}
  namespace: kube-system      # k3s's Helm controller watches here
spec:
  chart: {{ helm_app_chart }}
  repo: {{ helm_app_repo }}
{% if helm_app_version %}
  version: "{{ helm_app_version }}"
{% endif %}
  targetNamespace: {{ helm_app_namespace }}
  createNamespace: true
{% if helm_app_values | length > 0 %}
  valuesContent: |-
{{ helm_app_values | indent(4, true) }}
{% endif %}
