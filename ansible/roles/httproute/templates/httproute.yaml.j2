# Rendered by the httproute role — one HTTPRoute per app (data-driven from vars/routes.yml).
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: {{ route_name }}
  namespace: {{ route_namespace }}
spec:
  parentRefs:
    - name: main            # attach to the Gateway
      namespace: gateway
  hostnames:
    - "{{ route_hostname }}"
  rules:
    - backendRefs:
        - name: {{ route_service }}
          port: {{ route_port }}
