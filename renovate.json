{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits"
  ],
  "timezone": "America/Vancouver",
  "schedule": [
    "before 9am on monday"
  ],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 0,
  "minimumReleaseAge": "3 days",
  "osvVulnerabilityAlerts": true,
  "dependencyDashboardTitle": "🤖 Renovate Dependency Dashboard",
  "argocd": {
    "managerFilePatterns": [
      "/gitops/apps/.+\\.ya?ml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/gitops/.+\\.ya?ml$/"
    ]
  },
  "customManagers": [
    {
      "description": "Immich APP version pinned in the chart values (controllers.main.containers.main.image.tag)",
      "customType": "regex",
      "managerFilePatterns": [
        "/^gitops/immich/values\\.yaml$/"
      ],
      "matchStrings": [
        "tag:\\s*(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "ghcr.io/immich-app/immich-server",
      "datasourceTemplate": "docker"
    },
    {
      "description": "argo-cd install: the pinned upstream manifest URL in gitops/argocd/kustomization.yaml",
      "customType": "regex",
      "managerFilePatterns": [
        "/^gitops/argocd/kustomization\\.yaml$/"
      ],
      "matchStrings": [
        "https://raw\\.githubusercontent\\.com/argoproj/argo-cd/(?<currentValue>v\\d+\\.\\d+\\.\\d+)/manifests/install\\.yaml"
      ],
      "depNameTemplate": "argoproj/argo-cd",
      "datasourceTemplate": "github-releases"
    },
    {
      "description": "Generic '# renovate: datasource=… depName=…' comments above a version line (e.g. KUBECONFORM_VERSION in the CI workflow)",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/",
        "/^scripts/.+\\.sh$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>[a-z-]+)\\s+depName=(?<depName>[^\\s]+)(\\s+versioning=(?<versioning>[a-z-]+))?\\s*\\n\\s*[A-Z_]+:?\\s*[=:]?\\s*\"?(?<currentValue>v?\\d+\\.\\d+\\.\\d+)\"?"
      ]
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security"
    ],
    "schedule": [
      "at any time"
    ],
    "minimumReleaseAge": null
  },
  "packageRules": [
    {
      "description": "Label everything so PRs are easy to spot",
      "matchManagers": [
        "argocd",
        "kubernetes",
        "helmv3",
        "helm-values",
        "custom.regex"
      ],
      "addLabels": [
        "dependencies"
      ]
    },
    {
      "description": "Major bumps always get their own PR + a loud label",
      "matchUpdateTypes": [
        "major"
      ],
      "addLabels": [
        "⚠️ major"
      ]
    },
    {
      "description": "ntfy chart: Argo's repoURL carries the chart name, so the argocd manager computes '<path>/ntfy/ntfy' — point the lookup at the real OCI path",
      "matchDepNames": [
        "codeberg.org/wrenix/helm-charts/ntfy/ntfy"
      ],
      "overridePackageName": "codeberg.org/wrenix/helm-charts/ntfy"
    },
    {
      "description": "DB-migration-sensitive apps: never automerge, flag clearly (Immich chart+image+postgres, Vaultwarden, RomM, Kavita, Calibre)",
      "matchPackageNames": [
        "/immich/",
        "/vaultwarden/",
        "/rommapp/",
        "/kavita/",
        "/calibre-web-automated/"
      ],
      "addLabels": [
        "⚠️ db-migration"
      ]
    },
    {
      "description": "Stateless apps: PATCH + DIGEST bumps land in ONE weekly PR so there is a single thing to read on Monday. Never automerged — you review, you merge, you Sync.",
      "matchPackageNames": [
        "ghcr.io/gethomepage/homepage",
        "searxng/searxng",
        "ghcr.io/degoog-org/degoog",
        "sndxr/komf",
        "codeberg.org/wrenix/helm-charts/ntfy",
        "busybox"
      ],
      "matchUpdateTypes": [
        "patch",
        "digest"
      ],
      "groupName": "stateless patch updates",
      "addLabels": [
        "low-risk"
      ]
    },
    {
      "description": "Argo CD: one PR per upstream release (the pinned install URL). You merge, then re-apply gitops/argocd/ by hand — never automerged",
      "addLabels": [
        "argocd"
      ],
      "matchDepNames": [
        "argoproj/argo-cd"
      ]
    },
    {
      "description": "cert-manager: upstream says upgrade ONE minor at a time → one PR per minor stream (merge + Sync in order, read each release's upgrade notes)",
      "matchDepNames": [
        "cert-manager"
      ],
      "separateMultipleMinor": true,
      "addLabels": [
        "step-by-minor"
      ]
    }
  ],
  "automerge": false
}
